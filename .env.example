# Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional custom cost rates in USD per 1M tokens (leave blank for automatic model defaults)
GEMINI_INPUT_COST_PER_1M_USD=
GEMINI_OUTPUT_COST_PER_1M_USD=

# Database & Vector DB
DATABASE_URL=sqlite:///./data/prayatna.db
CHROMA_PATH=./data/chroma

# Security & Authentication (set strong random JWT_SECRET_KEY in production)
JWT_SECRET_KEY=
JWT_TTL_MINUTES=720
PUBLIC_APP_URL=http://localhost:3000

# Initial SaaS Bootstrap Accounts (used on first migration only)
SUPER_ADMIN_EMAIL=superadmin@prayatna-saas.local
SUPER_ADMIN_NAME=Platform Super Admin
SUPER_ADMIN_PASSWORD=
PRAYATNA_ADMIN_EMAIL=admin@prayatna.co.in
PRAYATNA_ADMIN_NAME=Prayatna Admin
PRAYATNA_ADMIN_PASSWORD=

# Application Configuration
# Set ALLOWED_ORIGINS to explicit comma-separated frontend origins if calling backend cross-origin with credentials.
ALLOWED_ORIGINS=
PUBLIC_CHAT_RATE_LIMIT=30
