# Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Database & Vector DB
DATABASE_URL=sqlite:///./data/prayatna.db
CHROMA_PATH=./data/chroma

# Application Configuration
# ALLOWED_ORIGINS: Set to * for all origins, or comma-separated list of domains/subdomains
ALLOWED_ORIGINS=*
FRONTEND_URL=*
# Optional: Regex to allow any subdomain of your domain (e.g. ^https?://([a-zA-Z0-9-]+\.)*yourdomain\.com(:[0-9]+)?$)
# CORS_ORIGIN_REGEX=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
